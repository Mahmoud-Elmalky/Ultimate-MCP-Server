# Core configuration (Ultimate MCP Server v2)
ULTIMATE_MCP_PROFILE=default
ULTIMATE_MCP_STATE_DIR=
ULTIMATE_MCP_OUTPUT_DIR=
ULTIMATE_MCP_LOG_LEVEL=INFO
ULTIMATE_MCP_LOG_FILE=
ULTIMATE_MCP_MAX_OUTPUT_BYTES=24000
ULTIMATE_MCP_MAX_CONCURRENCY=4
ULTIMATE_MCP_APPROVAL_TTL_SECONDS=600
ULTIMATE_MCP_TRANSPORT=stdio

# Configure narrow workspace roots explicitly (semicolon or comma separated paths).
# Do not grant an entire drive or home directory by default.
ULTIMATE_MCP_READ_ROOTS=
ULTIMATE_MCP_WRITE_ROOTS=

# Optional provider credentials (also used by legacy ultimate_mcp_server.py) — leave blank if unused
YOUTUBE_API_KEY=your_youtube_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
